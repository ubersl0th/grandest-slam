# Public — exposed to the browser. Use the new "publishable" key (sb_publishable_...)
# rather than the legacy anon key.
# For local Supabase the URL is http://127.0.0.1:54321 and the keys come from
# `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser. Use the new "secret" key
# (sb_secret_...) rather than the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# Resend — required for transactional emails (signup confirmation, admin
# notifications, magic-link sign-in, approval/rejection notices). Get a key
# from https://resend.com/api-keys.
RESEND_API_KEY=

# From-address for outbound mail. Must be on a verified Resend domain.
# Defaults to "team@mail.thegrandestslam.no" if unset.
EMAIL_FROM=team@mail.thegrandestslam.no

# Optional: canonical origin used to build links in outbound emails. Falls back
# to the request origin if unset — set this in production so admin-panel URLs
# and magic-link redirects always point to the public domain.
NEXT_PUBLIC_APP_URL=

# Local dev (NODE_ENV !== "production") auto-routes mail to the Mailpit instance
# bundled with `supabase start` — http://127.0.0.1:54324 (SMTP on 54325).
# No env vars needed; see [inbucket] in supabase/config.toml.