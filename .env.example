# Public — exposed to the browser. Use the new "publishable" key (sb_publishable_...)
# rather than the legacy anon key.
# For local Supabase the URL is http://127.0.0.1:54321 and the keys come from
# `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser. Use the new "secret" key
# (sb_secret_...) rather than the legacy service_role JWT.
SUPABASE_SECRET_KEY=
